{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./src",    // Onde o JS será criado
    "rootDir": "./src"     // Onde o TS original está
  },
  "include": ["src/**/*"], // Inclui os arquivos para compilar
  "exclude": ["node_modules"] // REMOVA o "./src" daqui!
}