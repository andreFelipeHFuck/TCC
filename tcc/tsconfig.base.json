{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tcc/adapters": ["lib/adapters/src/index.ts"],
      "@tcc/appwrite": ["lib/services/appwrite/src/index.ts"],
      "@tcc/appwrite-adapter": ["lib/adapters/appwrite-adapter/src/index.ts"],
      "@tcc/auth": ["lib/components/features/auth/src/index.ts"],
      "@tcc/big-query-adapter": ["lib/adapters/big-query-adapter/src/index.ts"],
      "@tcc/bigQuery": ["lib/services/bigQuery/src/index.ts"],
      "@tcc/capacitor-session": ["lib/services/capacitor-session/src/index.ts"],
      "@tcc/components/buttons": ["lib/components/shared/buttons/src/index.ts"],
      "@tcc/components/forms": ["lib/components/shared/forms/src/index.ts"],
      "@tcc/components/mobile-page": ["lib/components/shared/mobile-page/src/index.ts"],
      "@tcc/components/title": ["lib/components/shared/title/src/index.ts"],
      "@tcc/domain": ["lib/domain/src/index.ts"],
      "@tcc/mobile-page": ["lib/components/shared/mobile-page/src/index.ts"],
      "@tcc/models": ["lib/models/src/index.ts"],
      "@tcc/nest-logger": ["lib/services/nest-logger/src/index.ts"],
      "@tcc/nestjs-grpc": ["lib/services/nestjs-grpc/src/index.ts"],
      "@tcc/ocpp-socket": ["lib/socket/ocpp-socket/src/index.ts"],
      "@tcc/redis": ["lib/services/redis/src/index.ts"],
      "@tcc/services": ["lib/services/src/index.ts"],
      "@tcc/core": ["lib/services/core/src/index.ts"],
      "@tcc/types": ["lib/types/src/index.ts"],
      "@tcc/utils": ["lib/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
