{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tcc/types": ["lib/types/src/index.ts"],
      "@tcc/models": ["lib/models/src/index.ts"],
      "@tcc/domain": ["lib/domain/src/index.ts"],
      "@tcc/adapters": ["lib/adapters/src/index.ts"],
      "@tcc/services": ["lib/services/src/index.ts"],
      "@tcc/utils": ["lib/utils/src/index.ts"],
      "@tcc/appwrite": ["lib/services/appwrite/src/index.ts"],
      "@tcc/appwrite-adapter": ["lib/adapters/appwrite-adapter/src/index.ts"],
      "@tcc/ocpp-socket": ["lib/socket/ocpp-socket/src/index.ts"],
      "@tcc/bigQuery": ["lib/services/bigQuery/src/index.ts"],
      "@tcc/big-query-adapter": ["lib/adapters/big-query-adapter/src/index.ts"],
      "@tcc/nestjs-grpc": ["lib/services/nestjs-grpc/src/index.ts"],
      "@tcc/nest-logger": ["lib/services/nest-logger/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
