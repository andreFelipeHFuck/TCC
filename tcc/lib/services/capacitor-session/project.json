{
  "name": "capacitor-session",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/services/capacitor-session/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "lib/services/capacitor-session/ng-package.json",
        "tsConfig": "lib/services/capacitor-session/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "lib/services/capacitor-session/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lib/services/capacitor-session/jest.config.cts",
        "tsConfig": "lib/services/capacitor-session/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
