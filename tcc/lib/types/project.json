{
  "name": "types",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/types/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "generate-proto": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "mkdir -p lib/types/src/lib/grpc/generated",
            "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=lib/types/src/lib/grpc/generated --ts_proto_opt=esModuleInterop=true,outputServices=nice-grpc,outputJsonMethods=true --proto_path=lib/types/src/lib/grpc/proto lib/types/src/lib/grpc/proto/*.proto"
          ],
          "parallel": false
        }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/lib/types",
        "main": "lib/types/src/index.ts",
        "tsConfig": "lib/types/tsconfig.lib.json",
        "assets": ["lib/types/*.md", "lib/types/package.json"]
      }
    }
  }
}
